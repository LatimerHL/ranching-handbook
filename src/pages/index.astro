---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeKeyArt from '../components/HomeKeyArt.astro';
import Sidebar from '../components/Sidebar.astro';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
import { fanContentNotice, projectRepository, sitePath } from '../site.mjs';

const assets = sitePath(import.meta.env.BASE_URL, 'assets/');
const controlImages = [
  'github-mark-black.png',
  'github-mark-white.png',
  'cursors/pointer-light-32.png',
  'cursors/pointer-light-64.png',
  'cursors/pointer-dark-32.png',
  'cursors/pointer-dark-64.png',
].map(file => assets + file).join(' ');
---

<BaseLayout
  title="牧场笔记 · 中文手册"
  description="《史莱姆牧场》系列非官方中文手册。"
  themeColor="#edf3ff"
  pageClass="home"
>
  <link slot="head" rel="stylesheet" href={assets + 'home.css'} />
  <main class="home-hero" aria-labelledby="welcome" data-loading data-control-images={controlImages}>
    <HomeKeyArt />
    <Sidebar />
    <div class="home-actions">
      <ThemeSwitcher />
      <a class="home-icon-button motion-rise motion-feedback" href={projectRepository}
        aria-label="GitHub 项目仓库" style="--motion-delay: 75ms">
        <span class="home-github-icon" aria-hidden="true"></span>
      </a>
    </div>
    <div class="home-title">
      <h1 id="welcome" class="motion-rise">牧场笔记</h1>
      <p class="motion-rise" style="--motion-delay: 90ms">《史莱姆牧场》系列中文手册</p>
    </div>
    <div class="home-credit motion-rise" style="--motion-delay: 140ms">
      <div class="home-notice" set:html={fanContentNotice}></div>
    </div>
  </main>
</BaseLayout>
