---
interface Props {
  navigation?: boolean;
  home?: boolean;
}

const { navigation = false, home = false } = Astro.props;
---

{navigation ? (
  <div id="navigation-progress" class="navigation-progress" role="progressbar" aria-label="页面加载中"
    hidden transition:persist="navigation-progress" transition:animate="none">
    <span></span>
  </div>
) : (
  <div id={home ? undefined : 'page-loading'} class:list={['page-loading', { 'home-loading': home }]} role="status">
    <slot />
    <span class="loading-spinner" aria-hidden="true"></span>
    <span>加载中</span>
  </div>
)}

<style>
  .page-loading {
    position: fixed;
    inset: 0;
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: .75rem;
    background: var(--cover-base, var(--paper, #f8f5eb));
    color: var(--cover-loading-ink, var(--ink, #272c22));
    font-weight: 650;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity var(--motion-short) ease-out, visibility 0s linear var(--motion-short);
  }
  :global(body[data-page-loading] > :not(#page-loading)) { visibility: hidden; }
  :global(body[data-page-loading]) .page-loading[data-visible] {
    opacity: 1;
    visibility: visible;
    transition: none;
  }
  .home-loading {
    position: absolute;
    z-index: -3;
    isolation: isolate;
    overflow: hidden;
    background: var(--cover-base);
    transition: opacity var(--motion-medium) ease-out, visibility 0s linear var(--motion-medium);
  }
  .home-loading::after {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    background: color-mix(in srgb, var(--cover-base) 62%, transparent);
  }
  @media (scripting: enabled) {
    :global(.home-hero[data-loading]) .home-loading {
      opacity: 1;
      visibility: visible;
      transition: none;
    }
  }
  .navigation-progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 6;
    block-size: 3px;
    color: #6a42bd;
    pointer-events: none;
  }
  .navigation-progress[hidden] { display: none; }
  :global(html[data-theme="dark"]) .navigation-progress { color: #c6a6fd; }
  .navigation-progress span {
    display: block;
    block-size: 100%;
    background: currentColor;
    box-shadow: 0 1px 5px color-mix(in srgb, currentColor 40%, transparent);
    transform: scaleX(.08);
    transform-origin: left;
  }
  .loading-spinner {
    box-sizing: border-box;
    inline-size: 2rem;
    aspect-ratio: 1;
    border: .18rem solid color-mix(in srgb, currentColor 22%, transparent);
    border-block-start-color: currentColor;
    border-radius: 50%;
  }
  @media (prefers-reduced-motion: no-preference) {
    .loading-spinner { animation: page-loading-spin .8s linear infinite; }
  }
  @media (prefers-reduced-motion: reduce) {
    .page-loading { transition: none; }
  }
  @media (scripting: none) {
    .home-loading { display: none; }
  }
  @keyframes page-loading-spin {
    to { rotate: 1turn; }
  }
</style>
