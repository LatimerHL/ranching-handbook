---
import { sitePath } from '../site.mjs';
import landscape from '../data/home-scene.json';
import portrait from '../data/home-scene-portrait.json';
import { slimeRigs } from '../data/slime-parts';
import { slimePivots } from '../data/slime-pivots';
import { partMotions, bodySway, type PartMotion } from '../data/slime-motion';
import { slimeVoices } from '../data/slime-voice';
import HomeLightAccents from './HomeLightAccents.astro';
import LoadingIndicator from './LoadingIndicator.astro';

type Dimensions = { width: number; height: number };
type Point = { x: number; y: number };
type Rect = Dimensions & Point;
type Piece = Rect & {
  id: string;
  file: string;
  rotation?: number;
  mirrorX?: boolean;
  opacity?: number;
  filter?: string;
  tint?: string;
};
type Layer = { id: string; motion?: string; scale?: number; frame?: Rect & { canvas: Dimensions }; elements: Piece[] };
type Scene = {
  canvas: Dimensions;
  poster: Dimensions;
  layers: Layer[];
};

const assets = sitePath(import.meta.env.BASE_URL, 'assets/home-scene/');
// Mirrors the depth tiers in src/scripts/home-parallax.ts: the deeper a layer sits, the larger
// its idle scale swing, so items drift in the same proportion as they answer the pointer.
const idleDepths: Record<string, number> = {
  foreground: 4,
  'background-slimes': 8,
  'distant-slimes': 10,
  bubbles: 2,
};
const idleDepthOf = (layer: Layer) => idleDepths[layer.motion ?? layer.id] ?? 0;
const percent = (size: number, total: number) => (size / total * 100) + '%';
// The slimes that ship as cut-outs are assembled from parts: one image per layer, all on the same
// canvas, so the wrapper inherits the flat sprite's geometry and the parts stay registered to it.
const partSrc = (item: string, layer: string) => `${assets}parts/${item}/${layer}.webp`;
const faceLayers = ['eyes', 'wink'] as const;
// A part's ambient swing turns around the point where it leaves the body, so the pivot travels with
// the layer as its transform-origin; the swing size, cycle and phase ride along as custom properties
// so the stylesheet can run one keyframe pair for every part.
const motionOf = (motions: PartMotion[] | undefined, part: string) =>
  motions?.find(motion => motion.part === part);
const motionStyle = (motion: PartMotion | undefined) => motion === undefined ? undefined : {
  'transform-origin': `${(motion.origin[0] * 100).toFixed(2)}% ${(motion.origin[1] * 100).toFixed(2)}%`,
  '--swing': `${motion.angle}deg`,
  ...(motion.turn === undefined ? {} : { '--turn': `${motion.turn}deg` }),
  // A wing that turns edge-on narrows; stretching it along the hinge keeps the span, which is what the
  // far wing is already drawn with.
  ...(motion.stretch === undefined ? {} : { '--stretch': `${motion.stretch}` }),
  // Ears are flicked by script at their own pace; a duration would be ignored anyway.
  ...(motion.kind === 'twitch' ? {} : {
    '--motion-duration': `${motion.period}ms`,
    '--motion-delay': `${motion.offset}ms`,
  }),
};
/** Style for the moving half of a `fold` part: the crease position, which side swings, and the clock. */
const foldStyle = (fold: { at: number; side: 'left' | 'right' }, motion: PartMotion) => ({
  '--fold-x': `${(fold.at * 100).toFixed(2)}%`,
  '--fold-deg': fold.side === 'left' ? '176deg' : '-176deg',
  '--motion-duration': `${motion.period}ms`,
  '--motion-delay': `${motion.offset}ms`,
});
/** Style for a `clip` part's moving half: the split line is both the clip edge and the pivot.
 *  Both halves overlap this much so the antialiased edges cannot leave a hairline between them. */
const clipOverlap = 0.02;
const clipStyle = (clip: number, motion: PartMotion) => ({
  'clip-path': `inset(${((clip - clipOverlap) * 100).toFixed(2)}% 0 0 0)`,
  'transform-origin': `${(motion.origin[0] * 100).toFixed(2)}% ${(clip * 100).toFixed(2)}%`,
  '--swing': `${motion.angle}deg`,
  '--motion-duration': `${motion.period}ms`,
  '--motion-delay': `${motion.offset}ms`,
});
/** The still half of a `clip` part: everything above the split, plus the overlap band. */
const clipBase = (clip: number) => ({ 'clip-path': `inset(0 0 ${((1 - clip - clipOverlap) * 100).toFixed(2)}% 0)` });
const position = (rect: Rect, canvas: Dimensions) => ({
  left: percent(rect.x, canvas.width),
  top: percent(rect.y, canvas.height),
  width: percent(rect.width, canvas.width),
  height: percent(rect.height, canvas.height),
});
// Face center measured in the 760 脳 1124 Beatrix sprite.
const faceCenter = { x: 232 / 760, y: 196 / 1124 };
// The rays converge here in the original 1254 脳 1254 sky sprite.
const beamFocus = { x: 633 / 1254, y: 957 / 1254 };
const backgroundRect = (scene: Scene) => {
  const background = scene.layers.find(layer => layer.id === 'background');
  const sky = background?.elements.find(piece => piece.id === 'sky-background');
  if (!background || !sky) throw new Error('Key art scene is missing the sky anchor');

  const frame = background.frame ?? { x: 0, y: 0, ...scene.canvas, canvas: scene.canvas };
  const scale = background.scale ?? 1;
  const scaleX = frame.width * scale / frame.canvas.width;
  const scaleY = frame.height * scale / frame.canvas.height;

  return {
    file: sky.file,
    x: frame.x + frame.width * (1 - scale) / 2 + sky.x * scaleX,
    y: frame.y + frame.height * (1 - scale) / 2 + sky.y * scaleY,
    width: sky.width * scaleX,
    height: sky.height * scaleY,
  };
};
const frameStyle = (scene: Scene, beam: Point) => {
  const beatrix = scene.layers.find(layer => layer.id === 'beatrix')?.elements.find(piece => piece.id === 'beatrix');
  if (!beatrix) throw new Error('Key art scene is missing the Beatrix anchor');

  return {
    '--poster-width': scene.poster.width,
    '--poster-height': scene.poster.height,
    '--focus-x': (beatrix.x + beatrix.width * faceCenter.x) / scene.canvas.width,
    '--focus-y': (beatrix.y + beatrix.height * faceCenter.y) / scene.canvas.height,
    '--beam-x': percent(beam.x, scene.canvas.width),
    '--beam-y': percent(beam.y, scene.canvas.height),
  };
};
const scenes: { orientation: string; scene: Scene; beam: Point; background: Rect & { file: string } }[] = [
  { orientation: 'landscape', scene: landscape },
  { orientation: 'portrait', scene: portrait },
].map(({ orientation, scene }) => {
  const background = backgroundRect(scene);
  const beam = {
    x: background.x + background.width * beamFocus.x,
    y: background.y + background.height * beamFocus.y,
  };
  return { orientation, scene, beam, background };
});

// Both bubble sets use the same sprite names for different versions of the same artwork.
const assetId = (file: string) => file.replace(/^bubbles-clarified\//, 'bubbles/');
const assetsByPieceId = new Map<string, string>();

// A slime's voices live under its item id, which is the sprite name minus the folder and the
// `-slime` suffix: `foreground/slimes/cotton-slime.webp` -> `cotton`. The sea hen, the pogofruit and
// the plorts have no voice library, so they simply carry no `data-voice` and stay silent.
const voiceBase = assets + 'voice/';
// Only a slime answers a poke: the sprite name has to carry the `-slime` suffix, so the pink plort
// crystal (which is also just "pink") stays quiet.
const slimeOf = (file: string) => {
  // Plorts are pickups, not creatures: a plort named after its slime would borrow that slime's voice.
  if (file.startsWith('foreground/plorts/')) return undefined;
  const name = (file.split('/').pop() ?? '').replace(/\.(?:png|webp)$/, '');
  return name.endsWith('-slime') ? name.slice(0, -'-slime'.length) : name;
};
const voiceOf = (file: string) => {
  const item = slimeOf(file);
  return item && slimeVoices[item] ? item : undefined;
};

for (const { orientation, scene } of scenes) {
  const pieceIds = new Set<string>();

  for (const piece of scene.layers.flatMap(layer => layer.elements)) {
    if (!piece.id || pieceIds.has(piece.id)) {
      throw new Error(`Missing or duplicate ${orientation} key art piece ID: ${piece.id}`);
    }
    pieceIds.add(piece.id);

    const asset = assetId(piece.file);
    const pairedAsset = assetsByPieceId.get(piece.id);
    if (pairedAsset && pairedAsset !== asset) {
      throw new Error(`Key art piece ${piece.id} uses different assets: ${pairedAsset}, ${asset}`);
    }
    assetsByPieceId.set(piece.id, asset);
  }
}
---
<noscript>
  <style is:inline>
    .home-key-art-rig[data-rig-pending] { visibility: visible; }
  </style>
</noscript>

{scenes.map(({ orientation, scene, beam, background }) => (
  <div class="home-key-art" data-orientation={orientation} data-voice-src={voiceBase} aria-hidden="true">
    <div class="home-key-art-frame" style={frameStyle(scene, beam)}>
      {scene.layers.map(layer => (
        <>
          <div class="home-key-art-motion" data-motion={layer.motion ?? layer.id}>
            <div
              class="home-key-art-layer"
              data-layer={layer.id}
              data-idle={idleDepthOf(layer) ? '' : undefined}
              style={{
                ...(layer.frame ? position(layer.frame, scene.canvas) : {}),
                scale: layer.scale,
                ...(idleDepthOf(layer)
                  ? {
                      '--idle-peak': String(1 + idleDepthOf(layer) * .01),
                      '--idle-duration': `${(7.2 + idleDepthOf(layer) * .6).toFixed(2)}s`,
                      '--idle-delay': `${(-idleDepthOf(layer) * .9).toFixed(2)}s`,
                    }
                  : {}),
              }}
            >
              {layer.elements.map((piece, index) => {
                const src = assets + piece.file;
                const geometry = position(piece, layer.frame?.canvas ?? scene.canvas);
                const isLight = layer.motion === 'white-light';
                // Keep the sprite's top-left pivot for authored rotation and mirroring. Moving
                // that pivot by the same factor as the scale makes the whole sprite grow from the beam focus.
                const idleStep = idleDepthOf(layer) * .01;
                const idleDrift = idleStep
                  ? {
                      '--idle-dx': percent((piece.x - beam.x) * idleStep, piece.width),
                      '--idle-dy': percent((piece.y - beam.y) * idleStep, piece.height),
                    }
                  : {};
                const placement = {
                  ...(isLight ? {} : geometry),
                  ...idleDrift,
                  rotate: piece.rotation ? piece.rotation + 'deg' : undefined,
                  transform: piece.mirrorX ? 'translateX(100%) scaleX(-1)' : undefined,
                  opacity: piece.opacity,
                };
                const rig = piece.tint ? undefined : slimeRigs[piece.file];
                const pivot = piece.tint ? undefined : slimePivots[piece.file];
                const motions = piece.tint ? undefined : partMotions[piece.file];
                const sway = piece.tint ? undefined : bodySway[piece.file];
                // The wobble pivots on the eye line (the chicken's claws): the jelly wrapper carries
                // the transform origin, while the piece above it keeps the geometry, the authored
                // rotation in the portrait scene, and the idle breathing.
                const jellyStyle = pivot === undefined
                  ? undefined
                  : { '--jelly-y': `${(pivot * 100).toFixed(1)}%` };
                const artwork = rig ? (
                  // The rig wrapper is the piece: it carries the geometry the flat sprite used to
                  // carry, so the idle breathing and the pointer parallax still move one body, not
                  // a stack of parts that each breathe on their own.
                  <span
                    class="home-key-art-piece home-key-art-rig"
                    data-piece-id={piece.id}
                    data-asset-id={assetId(piece.file)}
                    data-rig={rig.item}
                    data-rig-pending=""
                    data-jelly={pivot === undefined ? undefined : ''}
                    data-sway={sway === undefined ? undefined : ''}
                    data-voice={voiceOf(piece.file)}
                    style={{ ...placement, filter: piece.filter, '--sway-angle': sway === undefined ? undefined : `${sway}deg` }}
                  >
                    <span class="home-key-art-jelly" style={jellyStyle}>
                      {rig.layers.map(part => {
                        const motion = motionOf(motions, part);
                        const fold = motion?.fold;
                        const clip = motion?.clip;
                        return (
                          <>
                            <img
                              class="home-key-art-part"
                              data-part={part}
                              data-motion={motion?.kind}
                              data-fold-base={fold === undefined ? undefined : fold.side}
                              data-hidden={rig.hidden?.includes(part) ? '' : undefined}
                              style={clip === undefined
                                ? (fold === undefined ? motionStyle(motion) : { ...motionStyle(motion), '--fold-x': `${(fold.at * 100).toFixed(2)}%` })
                                : clipBase(clip)}
                              src={partSrc(rig.item, part)}
                              alt=""
                              width={Math.round(piece.width)}
                              height={Math.round(piece.height)}
                              decoding="async"
                            />
                            {/* A `clip` part is the same art twice: the top half exactly as painted, and the
                                bottom half carrying the motion with its pivot on the split, so the line stays
                                put while the far end swings. */}
                            {clip === undefined ? null : (
                              <img
                                class="home-key-art-part"
                                data-part={`${part}-tail`}
                                data-motion={motion?.kind}
                                style={clipStyle(clip, motion)}
                                src={partSrc(rig.item, part)}
                                alt=""
                                width={Math.round(piece.width)}
                                height={Math.round(piece.height)}
                                decoding="async"
                              />
                            )}
                            {/* The moving half of a folded part: the same art, clipped to the flap side of the
                                crease, swung 180 degrees about that crease so it lies back over the wing. */}
                            {fold === undefined ? null : (
                              <img
                                class="home-key-art-part home-key-art-fold"
                                data-fold={fold.side}
                                data-fold-of={part}
                                style={foldStyle(fold, motion)}
                                src={partSrc(rig.item, part)}
                                alt=""
                                width={Math.round(piece.width)}
                                height={Math.round(piece.height)}
                                decoding="async"
                              />
                            )}
                          </>
                        );
                      })}
                      {/* Both faces stay in the document so a blink can swap them without a request.
                          A face is painted on the body, so it takes the body's own motion: if the body
                          sags, the eyes have to sag with it instead of floating off the surface. A body
                          split by `clip` keeps its head still, so its face keeps still too. */}
                      {faceLayers.map(face => {
                        const bodyMotion = motionOf(motions, 'body');
                        const faceMotion = bodyMotion?.clip === undefined ? bodyMotion : undefined;
                        return (
                          <img
                            class={`home-key-art-part home-key-art-face home-key-art-face--${face}`}
                            data-face={face}
                            data-part={face}
                            data-motion={faceMotion?.kind}
                            data-visible={face === (rig.face ?? 'eyes') ? '' : undefined}
                            style={motionStyle(faceMotion)}
                            src={partSrc(rig.item, face)}
                            alt=""
                            width={Math.round(piece.width)}
                            height={Math.round(piece.height)}
                            decoding="async"
                          />
                        );
                      })}
                    </span>
                  </span>
                ) : (
                  <>
                    {pivot === undefined ? (
                      <img
                        class="home-key-art-piece"
                        data-piece-id={piece.id}
                        data-asset-id={assetId(piece.file)}
                        data-voice={voiceOf(piece.file)}
                        src={src}
                        alt=""
                        width={Math.round(piece.width)}
                        height={Math.round(piece.height)}
                        style={{ ...placement, filter: piece.filter }}
                      />
                    ) : (
                      // A sprite with no cut-outs still wobbles on its eye line, so it needs the same
                      // wrapper the rigs use: the outer span holds the geometry, the jelly inside it
                      // is the part that squashes.
                      <span
                        class="home-key-art-piece"
                        data-piece-id={piece.id}
                        data-asset-id={assetId(piece.file)}
                        data-jelly=""
                        data-voice={voiceOf(piece.file)}
                        style={{ ...placement, filter: piece.filter }}
                      >
                        <span class="home-key-art-jelly" style={jellyStyle}>
                          <img
                            class="home-key-art-sprite"
                            src={src}
                            alt=""
                            width={Math.round(piece.width)}
                            height={Math.round(piece.height)}
                            decoding="async"
                          />
                        </span>
                      </span>
                    )}
                    {piece.tint && (
                      <span
                        class="home-key-art-piece home-key-art-tint"
                        style={{ ...placement, '--sprite': `url("${src}")`, 'background-image': piece.tint }}
                      />
                    )}
                  </>
                );
                if (!isLight) return artwork;

                return (
                  <span class="home-key-art-ray" style={{
                    ...geometry,
                    '--ray-x': percent(beam.x - piece.x, piece.width),
                    '--ray-y': percent(beam.y - piece.y, piece.height),
                    '--ray-duration': 9600 + (index % 6) * 840 + 'ms',
                  }}>
                    {artwork}
                  </span>
                );
              })}
            </div>
          </div>
          {layer.id === 'background' && (
            <HomeLightAccents orientation={orientation} canvas={scene.canvas} origin={beam} background={background} />
          )}
        </>
      ))}
    </div>
  </div>
))}

<LoadingIndicator home>
  {scenes.map(({ orientation, scene, beam, background }) => (
    <div class="home-key-art-preview" data-orientation={orientation} aria-hidden="true">
      <div class="home-key-art-frame" style={frameStyle(scene, beam)}>
        <img class="home-key-art-preview-sky" src={assets + background.file} alt=""
          style={position(background, scene.canvas)} />
      </div>
    </div>
  ))}
</LoadingIndicator>

<script is:inline>
  // Decide the active scene once per document (and again after a client-side swap) instead of
  // letting a media query re-evaluate mid-navigation: during a view transition the incoming page
  // can be measured at a transient size, which briefly matched `orientation: portrait` and faded
  // the portrait entrance in on top of the landscape one.
  (() => {
    const query = window.matchMedia('(orientation: portrait)');
    const root = document.documentElement;
    let fadeTimer;
    let current;

    const apply = () => {
      const next = query.matches ? 'portrait' : 'landscape';
      // First call for this document: paint the right scene straight away, never cross-fade, so a
      // transient viewport size during navigation cannot ghost the other orientation in.
      if (next === current) return;
      const first = current === undefined;
      current = next;
      root.dataset.layout = next;
      if (first) return;
      // Live change: keep both scenes painted for the length of the cross-fade.
      root.dataset.layoutFading = '';
      window.clearTimeout(fadeTimer);
      fadeTimer = window.setTimeout(() => {
        delete root.dataset.layoutFading;
      }, 460);
    };

    apply();
    query.addEventListener('change', apply);
    window.addEventListener('resize', apply);
    window.addEventListener('orientationchange', apply);
    document.addEventListener('astro:after-swap', () => {
      current = undefined;
      apply();
    });
  })();
</script>

<script>
  import '../scripts/home-key-art';
</script>

<style>
  .home-key-art, .home-key-art-preview {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    container-type: size;
  }
  .home-key-art {
    z-index: -3;
    /* Reveal span for light effects that fade in on load instead of popping with the entrance. */
    --key-art-reveal-duration: 1.35s;
  }
  .home-key-art-preview { z-index: -2; }
  .home-key-art-preview-sky { position: absolute; filter: blur(22px); }
  /* Only one scene is ever painted. The active one is chosen by `data-layout` on <html>, set once
     per document and after each swap, so a transient viewport size during navigation cannot bring
     the other orientation in. The media query stays as a no-JS fallback. */
  :is(.home-key-art, .home-key-art-preview)[data-orientation="portrait"] {
    background: var(--cover-base);
    opacity: 0;
    visibility: hidden;
  }
  :global(html[data-layout="portrait"]) :is(.home-key-art, .home-key-art-preview)[data-orientation="portrait"] {
    opacity: 1;
    visibility: visible;
  }
  :global(html[data-layout="portrait"]) :is(.home-key-art, .home-key-art-preview)[data-orientation="landscape"] {
    opacity: 0;
    visibility: hidden;
  }
  @media (orientation: portrait) {
    :global(html:not([data-layout])) :is(.home-key-art, .home-key-art-preview)[data-orientation="portrait"] {
      opacity: 1;
      visibility: visible;
    }
    :global(html:not([data-layout])) :is(.home-key-art, .home-key-art-preview)[data-orientation="landscape"] {
      opacity: 0;
      visibility: hidden;
    }
  }
  /* Live rotation cross-fades the two scenes. Both stay painted for the length of the transition,
     so the outgoing one fades out while the incoming one fades in instead of one popping in over
     the other. Outside this window the swap is instant (navigation must never ghost). */
  :global(html[data-layout-fading]) :is(.home-key-art, .home-key-art-preview)[data-orientation] {
    visibility: visible;
    transition: opacity 420ms var(--ease-enter, cubic-bezier(.22, .61, .21, 1));
  }
  /* Wait for the media as a whole so the loading preview never exposes a half-assembled scene. */
  @media (scripting: enabled) {
    :global(.home-hero[data-loading]) .home-key-art[data-orientation] {
      visibility: hidden;
      opacity: 0;
    }
  }
  .home-key-art-frame {
    --frame-width: max(100cqw, calc(100cqh * var(--poster-width) / var(--poster-height)));
    --frame-height: calc(var(--frame-width) * var(--poster-height) / var(--poster-width));
    position: absolute;
    left: clamp(calc(100cqw - var(--frame-width)), calc(50cqw - var(--frame-width) * var(--focus-x)), 0px);
    top: clamp(calc(100cqh - var(--frame-height)), calc(50cqh - var(--frame-height) * var(--focus-y)), 0px);
    width: var(--frame-width);
    height: var(--frame-height);
    /* Backdrop in the artwork's own colours: while a layer is still rasterising, the compositor fills
       the gap with what is behind it 鈥揳 light page background reads as a white block. Theme-scoped so
       the dark theme does not show a pale sky through the entry fade. */
    background: var(--key-art-backdrop, linear-gradient(180deg, #9fc9e6 0%, #b6dcee 32%, #a3cee2 60%, #7fa9c6 100%));
  }
  .home-key-art-motion, .home-key-art-layer { position: absolute; inset: 0; }
  .home-key-art-motion[data-motion="white-light"] { z-index: 1; }
  .home-key-art-motion:has(> :is(
    [data-layer="foreground-slimes"], [data-layer="foreground-bat"],
    [data-layer="foreground-butterfly"], [data-layer="foreground-rabbit"], [data-layer="ringtail"]
  )) { z-index: 2; }
  .home-key-art-motion[data-motion="beatrix"] { z-index: 3; }
  .home-key-art-motion, .home-key-art-layer[data-parallax] { transform-origin: var(--beam-x) var(--beam-y); }
  @media (prefers-reduced-motion: no-preference) {
    .home-key-art-layer[data-parallax] { transition: transform var(--motion-medium) var(--ease-enter); }
    .home-key-art[data-entrance] .home-key-art-ray {
      animation: key-art-ray-travel var(--ray-duration) linear calc(var(--ray-duration) * -.5) infinite;
    }
    .home-key-art[data-entrance] .home-key-art-motion[data-motion="white-light"] {
      opacity: 0;
      animation: key-art-light-reveal var(--key-art-reveal-duration) ease-out both;
    }
  }
  .home-key-art[data-orientation="portrait"] .home-key-art-frame { container-type: inline-size; }
  .home-key-art-piece { position: absolute; transform-origin: top left; }
  /* The artwork is a decorative backdrop and lets the pointer fall through. The slimes are the one
     exception: a poke is a click, and the piece has to be a hit target to hear it. */
  .home-key-art-piece[data-voice],
  .home-key-art-piece[data-jelly] { pointer-events: auto; }
  /* A poke squashes the body around the line through its eyes (the chicken's claws), which sits
     somewhere inside the sprite, so the wobble needs its own layer: the piece above it owns the
     geometry, the authored rotation and the idle breathing, and this one only scales. */
  .home-key-art-jelly {
    position: absolute;
    inset: 0;
    display: block;
    transform-origin: 50% var(--jelly-y, 50%);
    will-change: transform;
  }
  .home-key-art-jelly > .home-key-art-sprite { display: block; width: 100%; height: 100%; }
  /* A falling drop is a copy of one of the honey artwork's drip blobs: it fills the canvas so it starts
     exactly where the artwork drew it, then the script moves it down and out of sight. It is created at
     runtime, so the rule has to be global -- a scoped selector would compile to an attribute this node
     never carries, and the image would then paint at its intrinsic size instead of the rig's box. */
