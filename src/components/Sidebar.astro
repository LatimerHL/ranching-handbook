---
import { localArticle, repository, sitePath } from '../site.mjs';

const base = sitePath(import.meta.env.BASE_URL);
const links = [
  { label: '一代养殖攻略', href: base + localArticle('game-1/guide/farming-guide.md') },
  { label: '二代养殖攻略', href: base + localArticle('game-2/guide/farming-guide.md') },
  { label: '全系列术语表', href: base + localArticle('general/terminology.md') },
  { label: 'GitHub 资料索引', href: repository + '/blob/main/_INDEX.md' },
];
---

<div class="home-sidebar-scrim" aria-hidden="true"></div>
<button class="home-icon-button home-menu-toggle motion-rise motion-feedback" type="button" popovertarget="home-menu" aria-label="打开侧栏">
  <span class="home-menu-icon" aria-hidden="true"></span>
</button>
<nav id="home-menu" class="home-menu" popover aria-labelledby="home-menu-title">
  <div class="home-menu-heading">
    <h2 id="home-menu-title">快捷导航</h2>
    <button class="motion-feedback" type="button" popovertarget="home-menu" popovertargetaction="hide">收起</button>
  </div>
  <ul>
    {links.map(({ label, href }) =>
      <li><a class="motion-feedback" href={href}>{label}</a></li>
    )}
  </ul>
</nav>

<script>
  import { closePopover, isPopoverOpen, openPopover } from '../scripts/input-shim';

  /** Distance from the left edge where an opening swipe may start. */
  const edgeWidth = 120;
  /** Horizontal travel before a press turns into a drag. */
  const intent = 8;
  /** Leftward travel that commits a close. */
  const closeDistance = 64;
  /** Rightward travel that commits an open (starting from the edge). */
  const openDistance = 64;

  const drawer = document.getElementById('home-menu');
  const hero = document.querySelector('.home-hero');

  interface Gesture {
    startX: number;
    startY: number;
    wasOpen: boolean;
    width: number;
    moved: boolean;
    dx: number;
  }

  if (drawer && hero) {
    let gesture: Gesture | null = null;
    let pointerId: number | undefined;

    drawer.inert = !isPopoverOpen(drawer);

    const paint = (g: Gesture) => {
      // Closing: the drawer slides from 0 to -width. Opening: from -width to 0. Either way the
      // panel must track the finger pixel for pixel, so the raw travel drives the offset directly.
      const width = g.width || drawer.offsetWidth || 1;
      const offset = g.wasOpen ? Math.min(0, g.dx) : Math.min(0, -width + Math.max(0, g.dx));
      const clamped = Math.max(-width, offset);
      hero.style.setProperty('--drawer-offset', clamped + 'px');
      hero.style.setProperty('--drawer-progress', String(1 + clamped / width));
    };

    const settle = (open: boolean) => {
      hero.removeAttribute('data-drawer-dragging');
      hero.style.removeProperty('--drawer-offset');
      hero.style.removeProperty('--drawer-progress');
      gesture = null;
      pointerId = undefined;
      if (open) openPopover(drawer);
      else closePopover(drawer);
      drawer.inert = !open;
    };

    window.addEventListener('pointerdown', event => {
      const x = event.clientX;
      const y = event.clientY;
      const open = isPopoverOpen(drawer);
      if (open) {
        if (x > drawer.getBoundingClientRect().right + 8) return;
      } else if (x > edgeWidth) {
        return;
      }
      gesture = { startX: x, startY: y, wasOpen: open, width: drawer.offsetWidth, moved: false, dx: 0 };
      pointerId = event.pointerId;
    }, { passive: true, capture: true });

    window.addEventListener('pointermove', event => {
      const g = gesture;
      if (!g || event.pointerId !== pointerId) return;
      const dx = event.clientX - g.startX;
      const dy = event.clientY - g.startY;
      if (!g.moved) {
        if (Math.abs(dx) < intent || Math.abs(dx) <= Math.abs(dy)) return;
        g.moved = true;
        if (!g.wasOpen) {
          openPopover(drawer);
          g.width = drawer.offsetWidth;
        }
        hero.setAttribute('data-drawer-dragging', '');
      }
      g.dx = dx;
      paint(g);
    }, { passive: true, capture: true });

    const end = (event: PointerEvent) => {
      const g = gesture;
      if (!g || event.pointerId !== pointerId) return;
      const raw = event.clientX - g.startX;
      if (!g.moved) {
        gesture = null;
        pointerId = undefined;
        return;
      }
      // Opening drags travel right, closing drags travel left; judge each by its own axis.
      if (g.wasOpen) settle(raw > -closeDistance);
      else settle(raw >= openDistance);
    };

    window.addEventListener('pointerup', end, { passive: true, capture: true });
    window.addEventListener('pointercancel', end, { passive: true, capture: true });
  }
</script>
