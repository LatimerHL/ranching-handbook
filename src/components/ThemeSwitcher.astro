<button class="home-icon-button home-theme-toggle motion-rise motion-feedback" type="button" popovertarget="home-theme" aria-label="切换外观" style="--motion-delay: 45ms">
  <span class="home-theme-icon" aria-hidden="true"></span>
</button>
<div id="home-theme" class="home-theme" popover>
  <fieldset>
    <legend>外观</legend>
    <label class="motion-feedback"><input type="radio" name="site-theme" value="light" />日间</label>
    <label class="motion-feedback"><input type="radio" name="site-theme" value="dark" />夜间</label>
    <label class="motion-feedback"><input type="radio" name="site-theme" value="system" checked />跟随系统</label>
  </fieldset>
  <div class="home-tilt-control" hidden>
    <button class="motion-feedback" type="button">开启倾斜动效</button>
    <p role="status"></p>
  </div>
</div>
