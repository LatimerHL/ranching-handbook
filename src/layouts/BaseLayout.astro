---
import { ClientRouter, fade } from 'astro:transitions';
import LoadingIndicator from '../components/LoadingIndicator.astro';
import { defaultLocale, sitePath } from '../site.mjs';
import '../styles/motion.css';
import '../styles/controls.css';

const { title, description, themeColor = '#f8f5eb', locale = defaultLocale, pageClass } = Astro.props;
const assets = sitePath(import.meta.env.BASE_URL, 'assets/');
---

<!doctype html>
<html lang={locale} class={pageClass} transition:animate={fade({ duration: '260ms' })}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} data-light-color={themeColor} />
    <title>{title}</title>
    <script is:inline src={assets + 'theme.js'}></script>
    <link rel="stylesheet" href={assets + 'typography.css'} />
    <link rel="stylesheet" href={assets + 'cursor.css'} />
    <slot name="head" />
    <noscript>
      <style is:inline>
        #page-loading { display: none; }
        html body[data-page-loading] > :not(#page-loading) { visibility: visible; }
      </style>
    </noscript>
    <ClientRouter />
  </head>
  <body data-page-loading>
    <LoadingIndicator />
    <script is:inline data-astro-rerun>
      (() => {
        const page = document.body;
        if (!page.hasAttribute('data-page-loading')) return;
        window.setTimeout(() => {
          if (page.isConnected && page.hasAttribute('data-page-loading')) {
            page.querySelector('#page-loading')?.setAttribute('data-visible', '');
          }
        }, 160);
      })();
    </script>
    <slot />
    <LoadingIndicator navigation />
    <script>
      import '../scripts/site-navigation';
      import '../scripts/input-shim';
    </script>
  </body>
</html>

